int indexFrom3D(int x, int y, int z) {
    int res1 = push.resolution + 1;
    return x + y * res1 + z * res1 * res1;
}

vec3 interpolateVerts(vec4 v1, vec4 v2) {
    float t = (0.0 - v1.w) / (v2.w - v1.w);
    return v1.xyz + t * (v2.xyz - v1.xyz);
}

// Write the 21 floats perfectly packed for your C++ Vertex struct
void writeVertex(uint vIndex, vec3 pos, vec3 normal, vec2 uv) {
    uint offset = vIndex * 21; // 21 floats per vertex!

    // Position (12 bytes)
    vData[offset + 0] = pos.x; vData[offset + 1] = pos.y; vData[offset + 2] = pos.z;
    // Color (12 bytes) - Defaults to white
    vData[offset + 3] = 1.0; vData[offset + 4] = 1.0; vData[offset + 5] = 1.0;
    // Normal (12 bytes)
    vData[offset + 6] = normal.x; vData[offset + 7] = normal.y; vData[offset + 8] = normal.z;
    // TexCoord (8 bytes)
    vData[offset + 9] = uv.x; vData[offset + 10] = uv.y;
    // TexCoord1 (8 bytes)
    vData[offset + 11] = 0.0; vData[offset + 12] = 0.0;
    // Tangent (12 bytes)
    vData[offset + 13] = 0.0; vData[offset + 14] = 0.0; vData[offset + 15] = 0.0;
    // Bitangent (12 bytes)
    vData[offset + 16] = 0.0; vData[offset + 17] = 0.0; vData[offset + 18] = 0.0;
    // LightmapUV (8 bytes)
    vData[offset + 19] = 0.0; vData[offset + 20] = 0.0;
}

void main() {
    ivec3 id = ivec3(gl_GlobalInvocationID.xyz);
    if (id.x >= push.resolution || id.y >= push.resolution || id.z >= push.resolution) return;

    float stepSize = push.chunkSize / float(push.resolution);
    vec3 localPos = vec3(id) * stepSize;
    vec3 worldPos = push.chunkOrigin + localPos;

    // Grab the 8 corners of the cube
    vec4 cubeCorners[8];
    cubeCorners[0] = vec4(worldPos + vec3(0, 0, 0), densities[indexFrom3D(id.x, id.y, id.z)]);
    cubeCorners[1] = vec4(worldPos + vec3(stepSize, 0, 0), densities[indexFrom3D(id.x+1, id.y, id.z)]);
    cubeCorners[2] = vec4(worldPos + vec3(stepSize, stepSize, 0), densities[indexFrom3D(id.x+1, id.y+1, id.z)]);
    cubeCorners[3] = vec4(worldPos + vec3(0, stepSize, 0), densities[indexFrom3D(id.x, id.y+1, id.z)]);
    cubeCorners[4] = vec4(worldPos + vec3(0, 0, stepSize), densities[indexFrom3D(id.x, id.y, id.z+1)]);
    cubeCorners[5] = vec4(worldPos + vec3(stepSize, 0, stepSize), densities[indexFrom3D(id.x+1, id.y, id.z+1)]);
    cubeCorners[6] = vec4(worldPos + vec3(stepSize, stepSize, stepSize), densities[indexFrom3D(id.x+1, id.y+1, id.z+1)]);
    cubeCorners[7] = vec4(worldPos + vec3(0, stepSize, stepSize), densities[indexFrom3D(id.x, id.y+1, id.z+1)]);

    int cubeIndex = 0;
    if (cubeCorners[0].w < 0.0) cubeIndex |= 1;
    if (cubeCorners[1].w < 0.0) cubeIndex |= 2;
    if (cubeCorners[2].w < 0.0) cubeIndex |= 4;
    if (cubeCorners[3].w < 0.0) cubeIndex |= 8;
    if (cubeCorners[4].w < 0.0) cubeIndex |= 16;
    if (cubeCorners[5].w < 0.0) cubeIndex |= 32;
    if (cubeCorners[6].w < 0.0) cubeIndex |= 64;
    if (cubeCorners[7].w < 0.0) cubeIndex |= 128;

    if (edgeTable[cubeIndex] == 0) return;

    vec3 vertList[12];
    if ((edgeTable[cubeIndex] & 1) != 0) vertList[0] = interpolateVerts(cubeCorners[0], cubeCorners[1]);
    if ((edgeTable[cubeIndex] & 2) != 0) vertList[1] = interpolateVerts(cubeCorners[1], cubeCorners[2]);
    if ((edgeTable[cubeIndex] & 4) != 0) vertList[2] = interpolateVerts(cubeCorners[2], cubeCorners[3]);
    if ((edgeTable[cubeIndex] & 8) != 0) vertList[3] = interpolateVerts(cubeCorners[3], cubeCorners[0]);
    if ((edgeTable[cubeIndex] & 16) != 0) vertList[4] = interpolateVerts(cubeCorners[4], cubeCorners[5]);
    if ((edgeTable[cubeIndex] & 32) != 0) vertList[5] = interpolateVerts(cubeCorners[5], cubeCorners[6]);
    if ((edgeTable[cubeIndex] & 64) != 0) vertList[6] = interpolateVerts(cubeCorners[6], cubeCorners[7]);
    if ((edgeTable[cubeIndex] & 128) != 0) vertList[7] = interpolateVerts(cubeCorners[7], cubeCorners[4]);
    if ((edgeTable[cubeIndex] & 256) != 0) vertList[8] = interpolateVerts(cubeCorners[0], cubeCorners[4]);
    if ((edgeTable[cubeIndex] & 512) != 0) vertList[9] = interpolateVerts(cubeCorners[1], cubeCorners[5]);
    if ((edgeTable[cubeIndex] & 1024) != 0) vertList[10] = interpolateVerts(cubeCorners[2], cubeCorners[6]);
    if ((edgeTable[cubeIndex] & 2048) != 0) vertList[11] = interpolateVerts(cubeCorners[3], cubeCorners[7]);

    // Build Triangles
    for (int i = 0; triTable[cubeIndex][i] != -1; i += 3) {
        vec3 p0 = vertList[triTable[cubeIndex][i]];
        vec3 p1 = vertList[triTable[cubeIndex][i+1]];
        vec3 p2 = vertList[triTable[cubeIndex][i+2]];

        // Flat Normal Calculation
        vec3 normal = normalize(cross(p2 - p0, p1 - p0));

        // Safely reserve 3 vertex slots across thousands of threads
        uint vIndex = atomicAdd(vertexCount, 3);
        uint iIndex = atomicAdd(indexCount, 3);

        writeVertex(vIndex, p0, normal, vec2(0.0));
        writeVertex(vIndex + 1, p1, normal, vec2(0.0));
        writeVertex(vIndex + 2, p2, normal, vec2(0.0));

        // The indices just map 1:1 to the vertices for now
        indices[iIndex] = vIndex + 2;     // inverted CCW
        indices[iIndex + 1] = vIndex + 1;
        indices[iIndex + 2] = vIndex;     // inverted CCW
    }
}