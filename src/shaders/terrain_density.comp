#version 450

// 8x8x8 = 512 threads per workgroup
layout(local_size_x = 8, local_size_y = 8, local_size_z = 8) in;

layout(std430, binding = 0) writeonly buffer DensityBuffer {
    float densities[];
};

layout(push_constant) uniform PushConstants {
    vec3 chunkOrigin; float chunkSize;
    vec3 planetCenter; float planetRadius;
    float amplitude; float frequency;
    int octaves; int resolution;
    int lod;
} push;

// --- ASHIMA 3D SIMPLEX NOISE ---
vec4 permute(vec4 x){return mod(((x*34.0)+1.0)*x, 289.0);}
vec4 taylorInvSqrt(vec4 r){return 1.79284291400159 - 0.85373472095314 * r;}

float snoise(vec3 v){ 
    const vec2  C = vec2(1.0/6.0, 1.0/3.0) ;
    const vec4  D = vec4(0.0, 0.5, 1.0, 2.0);
    vec3 i  = floor(v + dot(v, C.yyy) );
    vec3 x0 = v - i + dot(i, C.xxx) ;
    vec3 g = step(x0.yzx, x0.xyz);
    vec3 l = 1.0 - g;
    vec3 i1 = min( g.xyz, l.zxy );
    vec3 i2 = max( g.xyz, l.zxy );
    vec3 x1 = x0 - i1 + 1.0 * C.xxx;
    vec3 x2 = x0 - i2 + 2.0 * C.xxx;
    vec3 x3 = x0 - 1.0 + 3.0 * C.xxx;
    i = mod(i, 289.0 ); 
    vec4 p = permute( permute( permute( 
                i.z + vec4(0.0, i1.z, i2.z, 1.0 ))
              + i.y + vec4(0.0, i1.y, i2.y, 1.0 )) 
              + i.x + vec4(0.0, i1.x, i2.x, 1.0 ));
    float n_ = 1.0/7.0;
    vec3  ns = n_ * D.wyz - D.xzx;
    vec4 j = p - 49.0 * floor(p * ns.z *ns.z);
    vec4 x_ = floor(j * ns.z);
    vec4 y_ = floor(j - 7.0 * x_ );
    vec4 x = x_ *ns.x + ns.yyyy;
    vec4 y = y_ *ns.x + ns.yyyy;
    vec4 h = 1.0 - abs(x) - abs(y);
    vec4 b0 = vec4( x.xy, y.xy );
    vec4 b1 = vec4( x.zw, y.zw );
    vec4 s0 = floor(b0)*2.0 + 1.0;
    vec4 s1 = floor(b1)*2.0 + 1.0;
    vec4 sh = -step(h, vec4(0.0));
    vec4 a0 = b0.xzyw + s0.xzyw*sh.xxyy ;
    vec4 a1 = b1.xzyw + s1.xzyw*sh.zzww ;
    vec3 p0 = vec3(a0.xy,h.x);
    vec3 p1 = vec3(a0.zw,h.y);
    vec3 p2 = vec3(a1.xy,h.z);
    vec3 p3 = vec3(a1.zw,h.w);
    vec4 norm = taylorInvSqrt(vec4(dot(p0,p0), dot(p1,p1), dot(p2, p2), dot(p3,p3)));
    p0 *= norm.x; p1 *= norm.y; p2 *= norm.z; p3 *= norm.w;
    vec4 m = max(0.6 - vec4(dot(x0,x0), dot(x1,x1), dot(x2,x2), dot(x3,x3)), 0.0);
    m = m * m;
    return 42.0 * dot( m*m, vec4( dot(p0,x0), dot(p1,x1), dot(p2,x2), dot(p3,x3) ) );
}
// ---------------------------------

void main() {
    ivec3 id = ivec3(gl_GlobalInvocationID.xyz);
    
    // We need 33x33x33 points to form 32x32x32 voxels
    if (id.x > push.resolution || id.y > push.resolution || id.z > push.resolution) return;

    // Calculate exact 3D world position
    float stepSize = push.chunkSize / float(push.resolution);
    vec3 localPos = vec3(id) * stepSize;
    vec3 worldPos = push.chunkOrigin + localPos;

    // --- PROCEDURAL MATH (Exactly matching your C++) ---
    float baseDistance = length(worldPos - push.planetCenter) - push.planetRadius; 
    float noiseValue = 0.0;
    float currentAmp = push.amplitude;
    float currentFreq = push.frequency;
    float weight = 1.0;

    int activeOctaves = push.octaves;
    if (push.lod >= 2) activeOctaves = 2;
    if (push.lod >= 4) activeOctaves = 1;

    for (int i = 0; i < 10; i++) { 
        if (i >= activeOctaves) break;
        float v = snoise(worldPos * currentFreq);
        v = 1.0 - abs(v);
        v *= v;
        noiseValue += v * currentAmp * weight;
        currentFreq *= 2.0;
        currentAmp *= 0.5;
        weight = clamp(v * 2.0, 0.0, 1.0); 
    }

    float finalDensity = baseDistance - noiseValue;

    // Flatten 3D index to 1D array
    int flatIndex = id.x + id.y * (push.resolution + 1) + id.z * (push.resolution + 1) * (push.resolution + 1);
    densities[flatIndex] = finalDensity;
}